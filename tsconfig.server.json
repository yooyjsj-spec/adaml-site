{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "server/dist",
    "rootDir": "server/src",
    "types": ["node"]
  },
  "include": ["server/src/**/*.ts"],
  "exclude": ["server/src/seed.ts"]
}
