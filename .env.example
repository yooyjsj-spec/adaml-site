# Local docker compose / start:all
DATABASE_URL=postgresql://smd:smd_dev_password@postgres:5432/smd_lab?schema=public
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_ORIGIN=http://localhost:8080
UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_PATH=/uploads
SESSION_TTL_HOURS=8
LOGIN_LOCKOUT_MINUTES=15
MAX_LOGIN_FAILURES=5
ADMIN_CRYPTO_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
VITE_API_BASE_URL=

# Email (SMTP) - used for signup verification / analysis-request notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SEOL <no-reply@example.com>
# New analysis-request notifications go here and to every ADMIN user email
ADMIN_NOTIFY_EMAIL=

# Synology (copy this file next to docker-compose.yml as .env)
POSTGRES_PASSWORD=replace-with-a-long-db-password
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
