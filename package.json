{
  "name": "smd-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://<USERNAME>.github.io/<REPO-NAME>",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "vite --host 0.0.0.0 & tsx watch server/src/index.ts",
    "start:all": "node scripts/start-all.mjs",
    "build": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:api",
    "preview": "vite preview",
    "api": "node server/dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "tsx server/src/seed.ts",
    "admin:create": "tsx server/src/createAdmin.ts",
    "test": "vitest run",
    "pack:synology": "node scripts/pack-synology.mjs",
    "covers:fetch": "tsx scripts/fetch-journal-covers.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "nodemailer": "^7.0.9",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "sanitize-html": "^2.17.7",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.1.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
